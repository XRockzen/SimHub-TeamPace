XCOPY /Y /R "$(TargetDir)$(TargetName).dll" "$(SIMHUB_INSTALL_PATH)"
XCOPY /Y /R "$(TargetDir)$(TargetName).pdb" "$(SIMHUB_INSTALL_PATH)"</PostBuildEvent>
