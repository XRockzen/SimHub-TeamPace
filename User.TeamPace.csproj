  <!-- 64-bit telemetry extractor, embedded in the plugin DLL (SimHub is 32-bit, DuckDB is 64-bit only) -->
  <ItemGroup>
    <ExtractorSource Include="Extractor\*.cs" />
    <ExtractorSource Include="TelemetryFormat.cs" />
    <EmbeddedResource Include="obj\TeamPace.Extractor.exe">
      <LogicalName>TeamPace.Extractor.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup>
    <ExtractorCsc>$(MSBuildToolsPath)\csc.exe</ExtractorCsc>
    <ExtractorCsc Condition="!Exists('$(ExtractorCsc)')">$(MSBuildToolsPath)\Roslyn\csc.exe</ExtractorCsc>
    <ExtractorCsc Condition="!Exists('$(ExtractorCsc)')">$(MSBuildFrameworkToolsPath)csc.exe</ExtractorCsc>
  </PropertyGroup>
  <Target Name="BuildExtractor" BeforeTargets="PrepareForBuild" Inputs="@(ExtractorSource)" Outputs="obj\TeamPace.Extractor.exe">
    <MakeDir Directories="obj" />
    <Exec Command="&quot;$(ExtractorCsc)&quot; /nologo /platform:x64 /optimize+ /target:exe /out:obj\TeamPace.Extractor.exe @(ExtractorSource->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>
